{
  "name": "@stubyard/client",
  "version": "0.5.0",
  "description": "Test helpers for stubyard (local email/SMS/OAuth testing hub): log in through stubyard's fake login providers from Playwright, get tokens without a browser.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./auth": { "types": "./dist/auth.d.ts", "import": "./dist/auth.js" },
    "./storage": { "types": "./dist/storage.d.ts", "import": "./dist/storage.js" },
    "./runs": { "types": "./dist/runs.d.ts", "import": "./dist/runs.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
