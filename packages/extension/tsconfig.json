{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["chrome", "vite/client"],
    "paths": { "@stubyard/client/*": ["../client/src/*"] }
  },
  "include": ["src", "test", "vite.config.ts", "vite.content.config.ts", "vitest.config.ts"]
}
