{
 "manifest_version": 3,
 "name": "stubyard widget spike (dynamic url)",
 "version": "0.0.1",
 "background": {
  "service_worker": "bg.js"
 },
 "side_panel": {
  "default_path": "panel.html"
 },
 "permissions": [
  "sidePanel",
  "storage",
  "scripting",
  "tabs",
  "activeTab",
  "clipboardWrite"
 ],
 "host_permissions": [
  "<all_urls>"
 ],
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "content.js"
   ],
   "run_at": "document_idle",
   "include_globs": [
    "*s=dyn*"
   ]
  }
 ],
 "web_accessible_resources": [
  {
   "resources": [
    "widget.html",
    "widget.js"
   ],
   "matches": [
    "<all_urls>"
   ],
   "use_dynamic_url": true
  }
 ]
}