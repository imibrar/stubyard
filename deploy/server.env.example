# Settings for deploy/docker-compose.server.yml (stubyard + Postgres on a server). Guide: docs/DEPLOY-SERVER.md
#
#   cp deploy/server.env.example deploy/.env && chmod 600 deploy/.env
#   docker compose -f deploy/docker-compose.server.yml --env-file deploy/.env up -d
#
# This file holds secrets (the database password, the admin password hash): keep it out of git and readable only by
# the account that runs docker. Values are used as written: no quotes needed, and none of them may contain spaces.

# ---------------------------------------------------------------- image
# Pin the version you tested (docs/DEPLOY-SERVER.md "Upgrading"). A local build: docker build -t stubyard:local .
STUBYARD_IMAGE=ghcr.io/imibrar/stubyard:latest

# ---------------------------------------------------------------- sign-in (required)
# The instance admin. Always signs in with this password, cannot be disabled or demoted from the dashboard.
STUBYARD_ADMIN_EMAIL=admin@example.com
# The admin password as a hash (scrypt:N:r:p:salt:hash; no $ signs, safe here). Make one without a running server:
#   docker run --rm -it ghcr.io/imibrar/stubyard:latest node dist/access/hash-password.js
# (asks for the password twice and prints the hash). STUBYARD_ADMIN_PASSWORD=<plain text> works too, but avoid it.
STUBYARD_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------- Postgres (required)
# The database container's own password. Long and random, e.g.: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
# Optional, defaults shown:
# POSTGRES_USER=stubyard
# POSTGRES_DB=stubyard
# Teams mode: where stubyard finds Postgres. "postgres" is the service name in the compose file (internal network);
# the password must be the same as POSTGRES_PASSWORD (URL-encode characters such as @ : / ? # if you use them).
STUBYARD_DATABASE_URL=postgres://stubyard:CHANGE-ME-SAME-AS-POSTGRES_PASSWORD@postgres:5432/stubyard

# ---------------------------------------------------------------- address (required)
# The address people open in the browser. https:// makes the session cookie Secure.
#   stubyard's own HTTPS (its CA):        https://stubyard.example.com:4443
#   behind Caddy / nginx on port 443:     https://stubyard.example.com
STUBYARD_PUBLIC_URL=https://stubyard.example.com:4443
# Host names / IPs stubyard answers to from other machines (comma separated). Requests with any other Host header are
# refused, which stops DNS-rebinding tricks. Include every name people use, e.g. stubyard.example.com,10.0.0.5
STUBYARD_ALLOWED_HOSTS=stubyard.example.com
# Extra names / IPs in stubyard's own HTTPS certificate (comma separated). Needed when you use stubyard's HTTPS
# directly (not behind a proxy): put the same names as above. Clients must trust the CA (GET /api/ca.crt).
STUBYARD_TLS_NAMES=stubyard.example.com
# Behind a TLS reverse proxy: "true" (one proxy in front), the number of proxies, or their IPs / CIDRs, so sign-in
# limits and the audit log see the real client address (X-Forwarded-For). Leave EMPTY when clients connect to
# stubyard directly: otherwise anyone can fake their address.
STUBYARD_TRUST_PROXY=

# ---------------------------------------------------------------- ports on the host (optional, defaults shown)
# All bound to 0.0.0.0 (every interface) by design; close what you do not need in the firewall (a cloud / host
# firewall: Docker's published ports bypass ufw and firewalld).
# Behind a reverse proxy on this host: 127.0.0.1, so only the proxy reaches the web ports (HTTP and HTTPS).
# STUBYARD_WEB_BIND=0.0.0.0
# STUBYARD_HTTP_PORT=4000
# STUBYARD_HTTPS_PORT=4443
# STUBYARD_SMTP_PORT=1025
# STUBYARD_APNS_PORT=2197

# ---------------------------------------------------------------- optional
# How long a sign-in lasts, in hours.
# STUBYARD_SESSION_TTL_HOURS=168
# 1 / 0 forces the Secure cookie flag on / off (default: on when STUBYARD_PUBLIC_URL is https).
# STUBYARD_COOKIE_SECURE=
# Days the audit log keeps its entries (0 = forever).
# STUBYARD_AUDIT_RETENTION_DAYS=365
# Days traffic logs are kept (projects can override this).
# STUBYARD_LOG_RETENTION_DAYS=7
# Hosts stubyard may call back (webhooks, callbacks): "+a.com,b.org" adds to the safe default, "*" = any.
# STUBYARD_OUTBOUND_ALLOW=
# STUBYARD_OUTBOUND_INSECURE_TLS=0
# STUBYARD_SMTP_STARTTLS=0
# STUBYARD_LOG_LEVEL=info
# AI chat keys (they win over keys stored in the dashboard).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# Docker names of the volumes and the network (change them only to run two stacks on one host).
# STUBYARD_DATA_VOLUME=stubyard-server-data
# STUBYARD_PG_VOLUME=stubyard-server-pg
# STUBYARD_NETWORK=stubyard-server
